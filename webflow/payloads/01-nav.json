height: 1.3; color: rgba(255, 255, 255, 0.62); text-decoration: none; white-space: nowrap; transition: color 0.2s ease; }\n.chapter-nav-link:hover { color: #ffffff; }\n.chapter-nav-link.w--current { color: #ffffff; }\n.chapter-nav-text { display: block; }\n.chapter-nav-num { margin-right: 6px; font-weight: 500; color: rgba(255, 255, 255, 0.34); }\n.chapter-nav-track { display: block; height: 2px; margin-top: 8px; border-radius: 2px; background-color: rgba(255, 255, 255, 0.14); overflow: hidden; }\n.chapter-nav-fill { display: block; width: 0%; height: 100%; background-color: #1bc594; }\n\n@media screen and (max-width: 991px) {\n  .main-nav-links { display: none; }\n  .menu-button { display: flex; }\n  .chapter-nav-list { gap: 18px; }\n  .chapter-nav-item { flex: 0 0 auto; }\n}\n@media screen and (max-width: 767px) {\n  .main-nav { padding: 12px 20px; }\n  .chapter-nav-list { padding: 0 20px; }\n  .brand-wordmark { width: 196px; height: 26px; }\n  .brand-mark { width: 27px; height: 27px; }\n}\n@media screen and (max-width: 479px) {\n  .brand-wordmark { width: 166px; height: 22px; }\n  .brand-mark { width: 23px; height: 23px; }\n}"}