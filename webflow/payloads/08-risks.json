 top: 28px; left: 32px; display: flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 50%; background-color: #13181d; font-size: 13px; font-weight: 600; color: #ffffff; }\n.risk-content { position: relative; display: flex; flex-direction: column; align-items: flex-start; }\n.risk-title { margin: 0 0 16px 0; font-size: 30px; line-height: 1.08; font-weight: 400; letter-spacing: -0.01em; }\n.risk-text { margin: 0 0 24px 0; font-size: 16px; line-height: 1.55; }\n.risk-link { display: inline-block; padding: 8px 18px; border: 1px solid #13181d; border-radius: 999px; font-size: 15px; line-height: 1.3; color: #13181d; text-decoration: none; transition: background-color 0.2s ease, color 0.2s ease; }\n.risk-link:hover { background-color: #13181d; color: #ffffff; }\n\n@media screen and (max-width: 991px) {\n  .risks-section { padding-top: 112px; padding-bottom: 112px; }\n  .risk-group { margin-top: 88px; }\n  .risk-grid-individual { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }\n  .risk-grid-systemic { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }\n  .risk-card-individual { min-height: 460px; }\n  .risk-card-systemic { min-height: 460px; }\n  .risk-title { font-size: 26px; }\n}\n@media screen and (max-width: 767px) {\n  .risks-section { padding-top: 88px; padding-bottom: 88px; }\n  .ripple-figure { padding: 20px 16px; }\n  .ripple-desktop { display: none; }\n  .ripple-mobile { display: block; }\n  .ripple-key { display: grid; }\n  .risk-group { margin-top: 72px; }\n  .risk-group-heading { font-size: 22px; margin-bottom: 20px; }\n  .risk-grid-individual { grid-template-columns: minmax(0, 1fr); gap: 12px; }\n  .risk-grid-systemic { grid-template-columns: minmax(0, 1fr); gap: 12px; }\n  .risk-card-individual { min-height: 400px; padding: 28px 24px; }\n  .risk-card-systemic { min-height: 400px; padding: 28px 24px; }\n  .risk-num { left: 24px; top: 24px; }\n  .risk-shape { width: 200px; height: 200px; top: -