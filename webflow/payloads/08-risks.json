{"html": "<section class=\"risks-section\" id=\"risks\">\n  <div class=\"wrap\">\n    <div class=\"split\">\n      <h2 class=\"label\">Risks of generative AI</h2>\n      <div class=\"split-body\">\n        <p class=\"lead\">As AI becomes more widespread, attention is growing to its risks: individual risks that affect specific people, and systemic risks that affect societies at large.</p>\n        <div class=\"ripple-figure\">\n          <div class=\"ripple-desktop\"><svg class=\"ripple-svg\" width=\"760\" height=\"372\" viewBox=\"0 0 760 372\" role=\"img\" aria-label=\"A person at the centre, an inner ring of individual risks and a wider outer ring of systemic risks\"><circle cx=\"380\" cy=\"192\" r=\"160\" fill=\"none\" stroke=\"#c596fe\" stroke-width=\"1.2\" stroke-dasharray=\"3 5\"/><circle cx=\"380\" cy=\"192\" r=\"88\" fill=\"none\" stroke=\"#ff885d\" stroke-width=\"1.2\"/><circle cx=\"380\" cy=\"192\" r=\"20\" fill=\"#f7cef6\"/><circle cx=\"380\" cy=\"187.0\" r=\"5.0\" fill=\"#13181d\"/><path d=\"M371.0 203.0a9.0 8.0 0 0 1 18.0 0z\" fill=\"#13181d\"/><text x=\"380\" y=\"228\" font-family=\"Switzer, Arial, sans-serif\" fill=\"rgba(255,255,255,0.62)\" font-size=\"11\" letter-spacing=\"1.2\" text-anchor=\"middle\">YOU</text><text x=\"380\" y=\"94\" font-family=\"Switzer, Arial, sans-serif\" fill=\"rgba(255,255,255,0.62)\" font-size=\"11\" letter-spacing=\"1.2\" text-anchor=\"middle\">INDIVIDUAL</text><text x=\"380\" y=\"22\" font-family=\"Switzer, Arial, sans-serif\" fill=\"rgba(255,255,255,0.62)\" font-size=\"11\" letter-spacing=\"1.2\" text-anchor=\"middle\">SYSTEMIC</text><circle cx=\"456.2\" cy=\"148.0\" r=\"10\" fill=\"#ff885d\"/><text x=\"456.2\" y=\"151.8\" font-family=\"Switzer, Arial, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#13181d\" text-anchor=\"middle\">1</text><text x=\"473.2\" y=\"153.0\" font-family=\"Switzer, Arial, sans-serif\" font-size=\"15\" fill=\"#ffffff\" stroke=\"#192027\" stroke-width=\"5\" paint-order=\"stroke\" stroke-linejoin=\"round\" text-anchor=\"start\">Bias and fairness</text><circle cx=\"380.0\" cy=\"280.0\" r=\"10\" fill=\"#ff885d\"/><text x=\"380.0\" y=\"283.8\" font-family=\"Switzer, Arial, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#13181d\" text-anchor=\"middle\">2</text><text x=\"397.0\" y=\"285.0\" font-family=\"Switzer, Arial, sans-serif\" font-size=\"15\" fill=\"#ffffff\" stroke=\"#192027\" stroke-width=\"5\" paint-order=\"stroke\" stroke-linejoin=\"round\" text-anchor=\"start\">Data privacy</text><circle cx=\"303.8\" cy=\"148.0\" r=\"10\" fill=\"#ff885d\"/><text x=\"303.8\" y=\"151.8\" font-family=\"Switzer, Arial, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#13181d\" text-anchor=\"middle\">3</text><text x=\"286.8\" y=\"153.0\" font-family=\"Switzer, Arial, sans-serif\" font-size=\"15\" fill=\"#ffffff\" stroke=\"#192027\" stroke-width=\"5\" paint-order=\"stroke\" stroke-linejoin=\"round\" text-anchor=\"end\">Information accuracy</text><circle cx=\"502.6\" cy=\"89.2\" r=\"10\" fill=\"#c596fe\"/><text x=\"502.6\" y=\"93.0\" font-family=\"Switzer, Arial, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#13181d\" text-anchor=\"middle\">4</text><text x=\"519.6\" y=\"94.2\" font-family=\"Switzer, Arial, sans-serif\" font-size=\"15\" fill=\"#ffffff\" stroke=\"#192027\" stroke-width=\"5\" paint-order=\"stroke\" stroke-linejoin=\"round\" text-anchor=\"start\">Environmental cost</text><circle cx=\"482.8\" cy=\"314.6\" r=\"10\" fill=\"#c596fe\"/><text x=\"482.8\" y=\"318.4\" font-family=\"Switzer, Arial, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#13181d\" text-anchor=\"middle\">5</text><text x=\"499.8\" y=\"319.6\" font-family=\"Switzer, Arial, sans-serif\" font-size=\"15\" fill=\"#ffffff\" stroke=\"#192027\" stroke-width=\"5\" paint-order=\"stroke\" stroke-linejoin=\"round\" text-anchor=\"start\">Impact on labour</text><circle cx=\"257.4\" cy=\"294.8\" r=\"10\" fill=\"#c596fe\"/><text x=\"257.4\" y=\"298.6\" font-family=\"Switzer, Arial, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#13181d\" text-anchor=\"middle\">6</text><text x=\"240.4\" y=\"299.8\" font-family=\"Switzer, Arial, sans-serif\" font-size=\"15\" fill=\"#ffffff\" stroke=\"#192027\" stroke-width=\"5\" paint-order=\"stroke\" stroke-linejoin=\"round\" text-anchor=\"end\">Information pollution</text><circle cx=\"277.2\" cy=\"69.4\" r=\"10\" fill=\"#c596fe\"/><text x=\"277.2\" y=\"73.2\" font-family=\"Switzer, Arial, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#13181d\" text-anchor=\"middle\">7</text><text x=\"260.2\" y=\"74.4\" font-family=\"Switzer, Arial, sans-serif\" font-size=\"15\" fill=\"#ffffff\" stroke=\"#192027\" stroke-width=\"5\" paint-order=\"stroke\" stroke-linejoin=\"round\" text-anchor=\"end\">Market and power concentration</text></svg></div>\n          <div class=\"ripple-mobile\"><svg class=\"ripple-svg\" width=\"340\" height=\"320\" viewBox=\"0 0 340 320\" role=\"img\" aria-label=\"A person at the centre, an inner ring of individual risks and a wider outer ring of systemic risks\"><circle cx=\"170\" cy=\"166\" r=\"124\" fill=\"none\" stroke=\"#c596fe\" stroke-width=\"1.2\" stroke-dasharray=\"3 5\"/><circle cx=\"170\" cy=\"166\" r=\"64\" fill=\"none\" stroke=\"#ff885d\" stroke-width=\"1.2\"/><circle cx=\"170\" cy=\"166\" r=\"16\" fill=\"#f7cef6\"/><circle cx=\"170\" cy=\"162.0\" r=\"4.0\" fill=\"#13181d\"/><path d=\"M162.8 174.8a7.2 6.4 0 0 1 14.4 0z\" fill=\"#13181d\"/><text x=\"170\" y=\"198\" font-family=\"Switzer, Arial, sans-serif\" fill=\"rgba(255,255,255,0.62)\" font-size=\"11\" letter-spacing=\"1.2\" text-anchor=\"middle\">YOU</text><text x=\"170\" y=\"92\" font-family=\"Switzer, Arial, sans-serif\" fill=\"rgba(255,255,255,0.62)\" font-size=\"11\" letter-spacing=\"1.2\" text-anchor=\"middle\">INDIVIDUAL</text><text x=\"170\" y=\"32\" font-family=\"Switzer, Arial, sans-serif\" fill=\"rgba(255,255,255,0.62)\" font-size=\"11\" letter-spacing=\"1.2\" text-anchor=\"middle\">SYSTEMIC</text><circle cx=\"225.4\" cy=\"134.0\" r=\"11\" fill=\"#ff885d\"/><text x=\"225.4\" y=\"137.8\" font-family=\"Switzer, Arial, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#13181d\" text-anchor=\"middle\">1</text><circle cx=\"170.0\" cy=\"230.0\" r=\"11\" fill=\"#ff885d\"/><text x=\"170.0\" y=\"233.8\" font-family=\"Switzer, Arial, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#13181d\" text-anchor=\"middle\">2</text><circle cx=\"114.6\" cy=\"134.0\" r=\"11\" fill=\"#ff885d\"/><text x=\"114.6\" y=\"137.8\" font-family=\"Switzer, Arial, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#13181d\" text-anchor=\"middle\">3</text><circle cx=\"265.0\" cy=\"86.3\" r=\"11\" fill=\"#c596fe\"/><text x=\"265.0\" y=\"90.1\" font-family=\"Switzer, Arial, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#13181d\" text-anchor=\"middle\">4</text><circle cx=\"249.7\" cy=\"261.0\" r=\"11\" fill=\"#c596fe\"/><text x=\"249.7\" y=\"264.8\" font-family=\"Switzer, Arial, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#13181d\" text-anchor=\"middle\">5</text><circle cx=\"75.0\" cy=\"245.7\" r=\"11\" fill=\"#c596fe\"/><text x=\"75.0\" y=\"249.5\" font-family=\"Switzer, Arial, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#13181d\" text-anchor=\"middle\">6</text><circle cx=\"90.3\" cy=\"71.0\" r=\"11\" fill=\"#c596fe\"/><text x=\"90.3\" y=\"74.8\" font-family=\"Switzer, Arial, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#13181d\" text-anchor=\"middle\">7</text></svg></div>\n          <div class=\"ripple-key\">\n            <div class=\"ripple-key-col\">\n              <p class=\"ripple-key-heading\">Individual risks</p>\n              <ol class=\"ripple-key-list\">\n            <li class=\"ripple-key-item\"><span class=\"ripple-key-num-individual\">1</span>Bias and fairness</li>\n            <li class=\"ripple-key-item\"><span class=\"ripple-key-num-individual\">2</span>Data privacy</li>\n            <li class=\"ripple-key-item\"><span class=\"ripple-key-num-individual\">3</span>Information accuracy</li>\n              </ol>\n            </div>\n            <div class=\"ripple-key-col\">\n              <p class=\"ripple-key-heading\">Systemic risks</p>\n              <ol class=\"ripple-key-list\">\n            <li class=\"ripple-key-item\"><span class=\"ripple-key-num-systemic\">4</span>Environmental cost</li>\n            <li class=\"ripple-key-item\"><span class=\"ripple-key-num-systemic\">5</span>Impact on labour</li>\n            <li class=\"ripple-key-item\"><span class=\"ripple-key-num-systemic\">6</span>Information pollution</li>\n            <li class=\"ripple-key-item\"><span class=\"ripple-key-num-systemic\">7</span>Market and power concentration</li>\n              </ol>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div class=\"risk-group\">\n      <h3 class=\"risk-group-heading\">Individual risks</h3>\n      <div class=\"risk-grid-individual\">\n          <article class=\"risk-card-individual\">\n            <svg viewBox=\"0 0 709.269 750.268\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"risk-shape\" aria-hidden=\"true\">\n<path d=\"M534.966 705.392C586.175 668.606 577.688 656.492 575.337 647.716C557.423 594.233 529.294 544.743 492.518 502C477.87 482.911 459.235 450.458 453.486 441.556C452.276 439.681 448.878 439.554 448.122 438.383C441.051 425.378 433.009 412.925 424.066 401.131C430.577 394.262 436.028 385.754 442.318 378.03C454.18 375.338 456.151 361.441 462.84 352.795C488.556 323.605 516.949 296.895 547.647 273.013C594.84 230.522 643.094 189.669 688.457 145.372C697.857 136.301 720.475 143.59 702.572 103.023L701.513 101.383C693.777 87.426 684.553 74.3506 674.004 62.382C632.247 3.36755 614.211 -11.2057 608.303 7.89633C606.774 12.2069 601.754 12.1334 597.571 12.8468C586.793 15.9434 576.79 21.2845 568.217 28.5178C559.327 34.2696 557.781 50.8803 549.593 56.1781C511.73 74.5731 475.049 95.3114 439.762 118.27C402.246 1